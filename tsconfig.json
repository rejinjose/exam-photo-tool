{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "scripts/**/*", "*.config.ts", "*.config.mjs"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "checkJs": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  }
}
